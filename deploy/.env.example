# 复制为 .env 后按需修改

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PORT=6379

# ---- RabbitMQ ----
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_CONSOLE_PORT=15672

# ---- 服务交付系统：AI 分诊 ----
# provider 保持 rule 时完全不联网；改成 openai 且填了 Key 才会调用模型
AI_PROVIDER=rule
AI_BASE_URL=http://127.0.0.1:8899/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=8
AI_DAILY_LIMIT=200

# ---- 员工全周期治理：邮件 ----
# 打开后会真实调用 SMTP；关闭时消费端只记录投递日志，不实际发信
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=25
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@workforce.local

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhanhe.servicedesk.system.mapper.ItTicketRecordMapper">

    <resultMap type="ItTicketRecord" id="ItTicketRecordResult">
        <id property="recordId" column="record_id"/>
        <result property="ticketId" column="ticket_id"/>
        <result property="processor" column="processor"/>
        <result property="action" column="action"/>
        <result property="processNote" column="process_note"/>
        <result property="processResult" column="process_result"/>
        <result property="processTime" column="process_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectItTicketRecordList" parameterType="Long" resultMap="ItTicketRecordResult">
        select record_id, ticket_id, processor, action, process_note, process_result,
               process_time, create_by, create_time
        from it_ticket_record
        where ticket_id = #{ticketId}
        order by record_id asc
    </select>

    <insert id="insertItTicketRecord" parameterType="ItTicketRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into it_ticket_record(ticket_id, processor, action, process_note, process_result,
                                     process_time, create_by, create_time)
        values(#{ticketId}, #{processor}, #{action}, #{processNote}, #{processResult},
               #{processTime}, #{createBy}, sysdate())
    </insert>
</mapper>

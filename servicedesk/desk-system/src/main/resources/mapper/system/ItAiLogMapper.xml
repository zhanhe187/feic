<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhanhe.servicedesk.system.mapper.ItAiLogMapper">

    <resultMap type="ItAiLog" id="ItAiLogResult">
        <id property="aiId" column="ai_id"/>
        <result property="scene" column="scene"/>
        <result property="ticketId" column="ticket_id"/>
        <result property="userName" column="user_name"/>
        <result property="provider" column="provider"/>
        <result property="model" column="model"/>
        <result property="degraded" column="degraded"/>
        <result property="costMs" column="cost_ms"/>
        <result property="inputDigest" column="input_digest"/>
        <result property="outputDigest" column="output_digest"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insertItAiLog" parameterType="ItAiLog" useGeneratedKeys="true" keyProperty="aiId">
        insert into it_ai_log(scene, ticket_id, user_name, provider, model, degraded, cost_ms,
                              input_digest, output_digest, create_time)
        values(#{scene}, #{ticketId}, #{userName}, #{provider}, #{model}, #{degraded}, #{costMs},
               #{inputDigest}, #{outputDigest}, sysdate())
    </insert>

    <select id="selectRecentLogs" resultMap="ItAiLogResult">
        select ai_id, scene, ticket_id, user_name, provider, model, degraded, cost_ms,
               input_digest, output_digest, create_time
        from it_ai_log
        <where>
            <if test="scene != null and scene != ''">and scene = #{scene}</if>
            <if test="ticketId != null">and ticket_id = #{ticketId}</if>
        </where>
        order by ai_id desc
        limit #{limit}
    </select>
</mapper>
